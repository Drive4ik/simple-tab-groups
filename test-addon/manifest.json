{
    "manifest_version": 2,

    "browser_specific_settings": {
        "gecko": {
            "id": "stg-behavior-tests@drive4ik",
            "strict_min_version": "140.0"
        }
    },

    "name": "STG behavior tests",
    "description": "Throwaway harness for verifying Firefox tab/tabGroups behavior. Not for publishing.",
    "version": "1.0",

    "incognito": "not_allowed",

    "permissions": [
        "tabs",
        "tabGroups",
        "tabHide",
        "sessions",
        "storage",
        "browserSettings",
        "menus",
        "cookies",
        "contextualIdentities",
        "webRequest",
        "webRequestBlocking",
        "management",
        "downloads",
        "<all_urls>"
    ],

    "optional_permissions": [
        "bookmarks"
    ],

    "background": {
        "type": "module",
        "scripts": ["harness.js"]
    },

    "content_scripts": [
        {
            "matches": ["https://example.org/*"],
            "js": ["sender.js"],
            "match_about_blank": true,
            "all_frames": true,
            "run_at": "document_end"
        }
    ],

    "web_accessible_resources": ["tab.html"]
}
