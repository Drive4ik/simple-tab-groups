{
    "include": [
        "addon/src/**/*.js"
    ],

    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "paths": {
            "/js/*": ["./addon/src/js/*"]
        },
    },

    "typeAcquisition": {
        "include": ["firefox-webext-browser"]
    },

    "vueCompilerOptions": {
        "extensions": [".vue"],
        "target": 2.7
    }
}
